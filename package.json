{
  "name": "evolufit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:types": "supabase gen types typescript --remote=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable --schema public > src/lib/supabase/database.types.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U postgres",
    "db:migrate": "supabase db push --remote=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable --yes",
    "test:db": "vitest run --config vitest.db.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
